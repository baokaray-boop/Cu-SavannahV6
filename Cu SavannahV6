-- TÌM REMOTE
local remoteAttack = nil
local remoteLatch = nil
for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        if v.Name == "AttackHandlerRemoteEvent" then
            remoteAttack = v
        elseif v.Name == "LatchedPlayersNotifyRemoteEvent" then
            remoteLatch = v
        end
    end
end

-- KILL AURA
local function killAuraLoop()
    while trangThai.killAura do
        pcall(function()
            local nv = LocalPlayer.Character
            local goc = nv and nv:FindFirstChild("HumanoidRootPart")
            if goc and remoteAttack and remoteAttack.Parent then
                local gan = nil
                local kcMin = 35
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local mt = p.Character:FindFirstChild("HumanoidRootPart")
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if mt and hum and hum.Health > 0 then
                            local kc = (goc.Position - mt.Position).Magnitude
                            if kc <= kcMin then
                                kcMin = kc
                                gan = p
                            end
                        end
                    end
                end
                if gan then
                    local humTarget = gan.Character:FindFirstChildOfClass("Humanoid")
                    if humTarget then remoteAttack:FireServer(humTarget) end
                end
            end
        end)
        task.wait(0.2)
    end
end

-- BAY CHẠY HỘ
local attBay = nil
local apBay = nil

local function batBay()
    local nv = LocalPlayer.Character
    local goc = nv and nv:FindFirstChild("HumanoidRootPart")
    local hum = nv and nv:FindFirstChildOfClass("Humanoid")
    if not goc or not hum then return end
    hum.PlatformStand = true
    if attBay then pcall(function() attBay:Destroy() end) end
    if apBay then pcall(function() apBay:Destroy() end) end
    attBay = Instance.new("Attachment")
    attBay.Name = "BayAttach"
    attBay.Parent = goc
    apBay = Instance.new("AlignPosition")
    apBay.Mode = Enum.PositionAlignmentMode.OneAttachment
    apBay.Attachment0 = attBay
    apBay.MaxForce = 1e6
    apBay.Responsiveness = 60
    apBay.Position = goc.Position
    apBay.Parent = goc
end

local function tatBay()
    pcall(function()
        local nv = LocalPlayer.Character
        if nv then
            local hum = nv:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end)
    if apBay then pcall(function() apBay:Destroy() end) apBay = nil end
    if attBay then pcall(function() attBay:Destroy() end) attBay = nil end
end

local function bayChayHoLoop()
    batBay()
    local daLen20 = false

    while trangThai.bayChayHo do
        pcall(function()
            local nv = LocalPlayer.Character
            local goc = nv and nv:FindFirstChild("HumanoidRootPart")
            local hum = nv and nv:FindFirstChildOfClass("Humanoid")
            if not goc or not hum then return end
            if not apBay or not apBay.Parent then batBay() end
            if not apBay then return end

            hum.PlatformStand = true

            local viTriGan = nil
            local humGan = nil
            local kcMin = 999
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local mt = p.Character:FindFirstChild("HumanoidRootPart")
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    if mt and h and h.Health > 0 then
                        local kc = (goc.Position - mt.Position).Magnitude
                        if kc < kcMin then
                            kcMin = kc
                            viTriGan = mt
                            humGan = h
                        end
                    end
                end
            end

            if viTriGan and humGan then
                local doCaoHienTai = goc.Position.Y - viTriGan.Position.Y

                if not daLen20 then
                    apBay.Position = Vector3.new(
                        viTriGan.Position.X,
                        viTriGan.Position.Y + 20,
                        viTriGan.Position.Z
                    )
                    apBay.Responsiveness = 60
                    if doCaoHienTai >= 19 then
                        daLen20 = true
                    end
                else
                    apBay.Position = Vector3.new(
                        viTriGan.Position.X,
                        viTriGan.Position.Y + 20,
                        viTriGan.Position.Z
                    )
                    local tocDoMT = humGan.WalkSpeed
                    if tocDoMT < 30 then tocDoMT = 30 end
                    apBay.Responsiveness = math.clamp(tocDoMT * 4, 80, 400)
                end
            end
        end)
        task.wait(0.05)
    end
    tatBay()
end

-- GỬI REMOTE GỠ GRAB
local function guiRemoteLatch()
    if not remoteLatch or not remoteLatch.Parent then return end
    local nv = LocalPlayer.Character
    local hum = nv and nv:FindFirstChildOfClass("Humanoid")
    pcall(function() remoteLatch:FireServer() end)
    pcall(function() remoteLatch:FireServer(LocalPlayer) end)
    pcall(function() remoteLatch:FireServer(nv) end)
    pcall(function() remoteLatch:FireServer(hum) end)
end

-- VIỀN CẦU VỒNG
local function taoVien(parent, doDay)
    local vien = Instance.new("UIStroke")
    vien.Thickness = doDay or 2
    vien.Color = Color3.fromRGB(255, 0, 0)
    vien.Parent = parent
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 0, 0)),
    }
    grad.Parent = vien
    task.spawn(function()
        while vien.Parent do
            for i = 0, 360, 5 do
                if not vien.Parent then break end
                grad.Rotation = i
                task.wait(0.03)
            end
        end
    end)
end

-- HÀM KÉO
local function keoDuoc(frame, getKhoa)
    local keo = false
    local bdX, bdY = 0, 0
    local khX, khY = 0, 0
    frame.InputBegan:Connect(function(input)
        if getKhoa and getKhoa() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            keo = true
            bdX = input.Position.X
            bdY = input.Position.Y
            khX = frame.Position.X.Offset
            khY = frame.Position.Y.Offset
        end
    end)
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            keo = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not keo then return end
        if getKhoa and getKhoa() then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local dx = input.Position.X - bdX
            local dy = input.Position.Y - bdY
            frame.Position = UDim2.new(0, khX + dx, 0, khY + dy)
        end
    end)
end

