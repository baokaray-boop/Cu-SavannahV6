vj.Color = Color3.fromRGB(0, 255, 100)
vj.Thickness = 2

local diemJoy = Instance.new("Frame")
diemJoy.Size = UDim2.new(0, 60, 0, 60)
diemJoy.Position = UDim2.new(0.5, -30, 0.5, -30)
diemJoy.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
diemJoy.BackgroundTransparency = 0.3
diemJoy.Parent = joystick
Instance.new("UICorner", diemJoy).CornerRadius = UDim.new(1, 0)

joystick.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        if ngonDangGiu == nil then
            dangKeoJoy = true
            ngonDangGiu = input
            tamJoy = Vector2.new(
                joystick.AbsolutePosition.X + joystick.AbsoluteSize.X/2,
                joystick.AbsolutePosition.Y + joystick.AbsoluteSize.Y/2
            )
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dangKeoJoy then return end
    if input ~= ngonDangGiu then return end
    local posChuot = Vector2.new(input.Position.X, input.Position.Y)
    local delta = posChuot - tamJoy
    local kc = delta.Magnitude
    local gioiHan = 40
    if kc > gioiHan then delta = delta.Unit * gioiHan end
    diemJoy.Position = UDim2.new(0.5, delta.X - 30, 0.5, delta.Y - 30)
    huongJoy = Vector3.new(delta.X / gioiHan, 0, delta.Y / gioiHan)
end)

UserInputService.InputEnded:Connect(function(input)
    if not dangKeoJoy then return end
    if input == ngonDangGiu then
        dangKeoJoy = false
        ngonDangGiu = nil
        diemJoy.Position = UDim2.new(0.5, -30, 0.5, -30)
        huongJoy = Vector3.new(0, 0, 0)
    end
end)

-- FLY GIỐNG KALI (BodyVelocity + BodyGyro)
local bvFly = nil
local bgFly = nil

local function batFly()
    local nv = LocalPlayer.Character
    local goc = nv and nv:FindFirstChild("HumanoidRootPart")
    local hum = nv and nv:FindFirstChildOfClass("Humanoid")
    if not goc or not hum then return end
    hum.PlatformStand = true
    -- BodyVelocity - di chuyển
    if bvFly then pcall(function() bvFly:Destroy() end) end
    bvFly = Instance.new("BodyVelocity")
    bvFly.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bvFly.P = 1250
    bvFly.Velocity = Vector3.new(0, 0, 0)
    bvFly.Parent = goc
    -- BodyGyro - xoay mặt (MaxTorque giống Kali)
    if bgFly then pcall(function() bgFly:Destroy() end) end
    bgFly = Instance.new("BodyGyro")
    bgFly.MaxTorque = Vector3.new(8999999488, 8999999488, 8999999488)
    bgFly.P = 3000
    bgFly.D = 500
    bgFly.CFrame = goc.CFrame
    bgFly.Parent = goc
end

local function tatFly()
    if bvFly then pcall(function() bvFly:Destroy() end) bvFly = nil end
    if bgFly then pcall(function() bgFly:Destroy() end) bgFly = nil end
    pcall(function()
        local nv = LocalPlayer.Character
        if nv then
            local hum = nv:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end)
end

-- Cập nhật velocity + gyro mỗi frame (giống Kali)
RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        if not trangThai.fly then return end
        local nv = LocalPlayer.Character
        local goc = nv and nv:FindFirstChild("HumanoidRootPart")
        if not goc then return end
        if not bvFly or not bvFly.Parent then batFly() end
        if not bvFly then return end
        -- Hướng bay theo camera
        if huongJoy.Magnitude > 0.05 then
            local huongCam = Camera.CFrame.LookVector
            local huongPhai = Camera.CFrame.RightVector
            local huongDi = (huongCam * -huongJoy.Z + huongPhai * huongJoy.X)
            huongDi = Vector3.new(huongDi.X, 0, huongDi.Z)
            if huongDi.Magnitude > 0.1 then
                huongDi = huongDi.Unit
                bvFly.Velocity = huongDi * trangThai.tocDoFly
            else
                bvFly.Velocity = Vector3.new(0, 0, 0)
            end
        else
            bvFly.Velocity = Vector3.new(0, 0, 0)
        end
        -- Xoay mặt theo camera (BodyGyro)
        if bgFly and bgFly.Parent then
            local huongCam = Camera.CFrame.LookVector
            bgFly.CFrame = CFrame.lookAt(goc.Position, goc.Position + Vector3.new(huongCam.X, 0, huongCam.Z))
        end
    end)
end)

