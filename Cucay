-- Mục tiêu Bá Khí
local mtBK = nil

local function dsN()
    local d = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and not wl[p] then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local m = p.Character:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and m then table.insert(d, p) end
        end
    end
    return d
end

local function timMT()
    local nv = LP.Character
    local g = nv and nv:FindFirstChild("HumanoidRootPart")
    if not g then return nil end
    local gan, km = nil, math.huge
    for _, p in ipairs(dsN()) do
        local m = p.Character:FindFirstChild("HumanoidRootPart")
        if m then
            local kc = (g.Position - m.Position).Magnitude
            if kc < km then km = kc; gan = p end
        end
    end
    return gan
end

local function doiMT(b)
    local d = dsN()
    if #d == 0 then return end
    local i = 1
    for j, p in ipairs(d) do if p == mtBK then i = j break end end
    i = i + b
    if i < 1 then i = #d end
    if i > #d then i = 1 end
    mtBK = d[i]
end

nutTru.MouseButton1Click:Connect(function() doiMT(-1) end)
nutCong.MouseButton1Click:Connect(function() doiMT(1) end)

-- BV
local bvC, bgC = nil, nil
local cheDo = "none"

local function batBV()
    local nv = LP.Character
    local g = nv and nv:FindFirstChild("HumanoidRootPart")
    local h = nv and nv:FindFirstChildOfClass("Humanoid")
    if not g or not h then return end
    h.PlatformStand = true
    if bvC then pcall(function() bvC:Destroy() end) end
    bvC = Instance.new("BodyVelocity")
    bvC.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bvC.P = 1250
    bvC.Velocity = Vector3.new(0,0,0)
    bvC.Parent = g
    if bgC then pcall(function() bgC:Destroy() end) end
    bgC = Instance.new("BodyGyro")
    bgC.MaxTorque = Vector3.new(8999999488, 8999999488, 8999999488)
    bgC.P = 3000; bgC.D = 500
    bgC.CFrame = g.CFrame
    bgC.Parent = g
end

local function tatBV()
    if bvC then pcall(function() bvC:Destroy() end) bvC = nil end
    if bgC then pcall(function() bgC:Destroy() end) bgC = nil end
    local nv = LP.Character
    if nv then
        local h = nv:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

local bkSt, bkTG, bkGoc = "a", 0, 0

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        local nv = LP.Character
        local g = nv and nv:FindFirstChild("HumanoidRootPart")
        if not g then return end
        if cheDo == "none" then return end
        if not bvC or not bvC.Parent then batBV() end
        if not bvC then return end
        local velAuto = Vector3.new(0, 0, 0)
        if cheDo == "bk" then
            if not mtBK or not mtBK.Parent or wl[mtBK] then
                mtBK = timMT()
            end
            if not mtBK or not mtBK.Character then
                bvC.Velocity = Vector3.new(0, 0, 0)
                return
            end
            local mh = mtBK.Character:FindFirstChild("HumanoidRootPart")
            if not mh then return end
            if bkSt == "a" then
                local vd = mh.Position + Vector3.new(0,20,0)
                local hg = vd - g.Position
                if hg.Magnitude < 3 then bkSt = "c"; bkTG = 0
                else velAuto = hg.Unit * tt.spdF end
            elseif bkSt == "c" then
                local kc = (g.Position - mh.Position).Magnitude
                if kc < 25 then bkTG = bkTG + dt end
                bkGoc = bkGoc + dt*1.5
                local vd = mh.Position + Vector3.new(math.cos(bkGoc)*12, 20, math.sin(bkGoc)*12)
                local hg = vd - g.Position
                velAuto = hg.Magnitude > 0.5 and hg.Unit * math.min(tt.spdF, hg.Magnitude*4) or Vector3.new(0,0,0)
                if bkTG >= 7 then bkSt = "r"; bkTG = 0 end
            elseif bkSt == "r" then
                local hx = g.Position - mh.Position
                hx = Vector3.new(hx.X, 0, hx.Z)
                if hx.Magnitude < 0.5 then hx = Vector3.new(1,0,0) end
                hx = hx.Unit
                local vd = Vector3.new(mh.Position.X + hx.X*40, mh.Position.Y, mh.Position.Z + hx.Z*40)
                local hg = vd - g.Position
                if hg.Magnitude < 3 then bkSt = "w"; bkTG = 0
                else velAuto = hg.Unit * tt.spdF end
            elseif bkSt == "w" then
                bkTG = bkTG + dt
                velAuto = Vector3.new(0, -50, 0)
                if bkTG >= 0.2 then bkSt = "a"; bkTG = 0 end
            end
        end
        local velU = Vector3.new(0, 0, 0)
        if hJoy.Magnitude > 0.05 then
            local hC = Cam.CFrame.LookVector
            local hP = Cam.CFrame.RightVector
            local hh = hC * -hJoy.Z + hP * hJoy.X
            hh = Vector3.new(hh.X, 0, hh.Z)
            if hh.Magnitude > 0.1 then velU = hh.Unit * tt.spdF end
        end
        local velY = Vector3.new(0, hY * tt.spdF, 0)
        bvC.Velocity = velAuto + velU + velY
        if bgC and bgC.Parent then
            local hC = Cam.CFrame.LookVector
            bgC.CFrame = CFrame.lookAt(g.Position, g.Position + Vector3.new(hC.X, 0, hC.Z))
        end
    end)
end)

RunService.Heartbeat:Connect(function(dt)
    if not tt.fly or cheDo ~= "none" then return end
    pcall(function()
        local nv = LP.Character
        local g = nv and nv:FindFirstChild("HumanoidRootPart")
        if not g then return end
        if not bvC or not bvC.Parent then batBV() end
        if not bvC then return end
        local hN = Vector3.new(0,0,0)
        if hJoy.Magnitude > 0.05 then
            local hC = Cam.CFrame.LookVector
            local hP = Cam.CFrame.RightVector
            local hh = hC * -hJoy.Z + hP * hJoy.X
            hh = Vector3.new(hh.X, 0, hh.Z)
            if hh.Magnitude > 0.1 then hN = hh.Unit end
        end
        local hD = Vector3.new(0, hY, 0)
        local hT = hN + hD
        bvC.Velocity = hT.Magnitude > 0.05 and hT.Unit * tt.spdF or Vector3.new(0,0,0)
        if bgC and bgC.Parent then
            local hC = Cam.CFrame.LookVector
            bgC.CFrame = CFrame.lookAt(g.Position, g.Position + Vector3.new(hC.X, 0, hC.Z))
        end
    end)
end)

