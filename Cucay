local bvFly, bgFly

local function batFly()
    local nv = LP.Character
    local goc = nv and nv:FindFirstChild("HumanoidRootPart")
    local h = nv and nv:FindFirstChildOfClass("Humanoid")
    if not goc or not h then return end
    h.PlatformStand = true
    if bvFly then pcall(function() bvFly:Destroy() end) end
    bvFly = Instance.new("BodyVelocity")
    bvFly.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bvFly.P = 1250
    bvFly.Velocity = Vector3.new(0, 0, 0)
    bvFly.Parent = goc
    if bgFly then pcall(function() bgFly:Destroy() end) end
    bgFly = Instance.new("BodyGyro")
    bgFly.MaxTorque = Vector3.new(8999999488, 8999999488, 8999999488)
    bgFly.P = 3000
    bgFly.D = 500
    bgFly.CFrame = goc.CFrame
    bgFly.Parent = goc
end

local function tatFly()
    if bvFly then pcall(function() bvFly:Destroy() end) bvFly = nil end
    if bgFly then pcall(function() bgFly:Destroy() end) bgFly = nil end
    hY = 0
    local nv = LP.Character
    if nv then
        local h = nv:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

RunService.Heartbeat:Connect(function(dt)
    if not tt.fly then return end
    pcall(function()
        local nv = LP.Character
        local goc = nv and nv:FindFirstChild("HumanoidRootPart")
        if not goc then return end
        if not bvFly or not bvFly.Parent then batFly() end
        if not bvFly then return end
        local hN = Vector3.new(0, 0, 0)
        if hJoy.Magnitude > 0.05 then
            local hC = Cam.CFrame.LookVector
            local hP = Cam.CFrame.RightVector
            local hh = hC * -hJoy.Z + hP * hJoy.X
            hh = Vector3.new(hh.X, 0, hh.Z)
            if hh.Magnitude > 0.1 then hN = hh.Unit end
        end
        local hD = Vector3.new(0, hY, 0)
        local hT = hN + hD
        if hT.Magnitude > 0.05 then
            bvFly.Velocity = hT.Unit * tt.spdFly
        else
            bvFly.Velocity = Vector3.new(0, 0, 0)
        end
        if bgFly and bgFly.Parent then
            local hC = Cam.CFrame.LookVector
            bgFly.CFrame = CFrame.lookAt(goc.Position, goc.Position + Vector3.new(hC.X, 0, hC.Z))
        end
    end)
end)

