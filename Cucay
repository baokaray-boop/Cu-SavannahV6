-- HITBOX
local hbPart = nil
local sizeGoc = {}

local function laPartThan(n)
    n = string.lower(n)
    return n:find("head") or n:find("capsule_head") or n:find("neck")
        or n:find("torso") or n:find("body") or n:find("upper")
        or n:find("lower") or n:find("chest") or n:find("spine")
end

local function taoHB()
    if hbPart then pcall(function() hbPart:Destroy() end) end
    local folder = workspace
    for _, v in ipairs(workspace:GetChildren()) do
        if v.Name == "Leaves" then folder = v break end
    end
    hbPart = Instance.new("Part")
    hbPart.Name = "Hitbox"
    hbPart.Size = Vector3.new(tt.hbSize, tt.hbSize/4, tt.hbSize/2)
    hbPart.Anchored = true
    hbPart.CanCollide = false
    hbPart.Material = Enum.Material.ForceField
    hbPart.Color = Color3.fromRGB(255, 0, 0)
    hbPart.Transparency = tt.hbMo / 100
    hbPart.Parent = folder
end

task.spawn(function()
    while true do
        task.wait(0.2)
        if tt.hb then
            local nv = LP.Character
            local g = nv and nv:FindFirstChild("HumanoidRootPart")
            if g and hbPart then
                local huong = g.CFrame.LookVector
                local vt = g.Position + huong * (tt.hbSize/2 + 3)
                hbPart.CFrame = CFrame.new(vt)
                hbPart.Size = Vector3.new(tt.hbSize, tt.hbSize/4, tt.hbSize/2)
                hbPart.Transparency = tt.hbMo / 100
            end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character and not wl[p] then
                    for _, obj in ipairs(p.Character:GetDescendants()) do
                        if obj:IsA("BasePart") and laPartThan(obj.Name) then
                            local key = p.Name .. "_" .. obj.Name
                            if not sizeGoc[key] then sizeGoc[key] = obj.Size end
                            pcall(function()
                                obj.Size = Vector3.new(tt.hbSize/2, tt.hbSize/2, tt.hbSize/2)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

local function phucHoi()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            for _, obj in ipairs(p.Character:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local key = p.Name .. "_" .. obj.Name
                    if sizeGoc[key] then
                        pcall(function() obj.Size = sizeGoc[key] end)
                    end
                end
            end
        end
    end
    sizeGoc = {}
end

