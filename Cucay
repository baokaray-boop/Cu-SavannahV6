-- KILL AURA
task.spawn(function()
    while task.wait(0.2) do
        if tt.ka and rAtk then
            pcall(function()
                local nv = LP.Character
                local g = nv and nv:FindFirstChild("HumanoidRootPart")
                if not g then return end
                local bk = tt.hb and (tt.hbSize + 10) or 35
