local rAttack, rLatch
for _, v in ipairs(RS:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        if v.Name == "AttackHandlerRemoteEvent" then rAttack = v
        elseif v.Name == "LatchedPlayersNotifyRemoteEvent" then rLatch = v end
    end
end

-- KILL AURA
task.spawn(function()
    while task.wait(0.2) do
        if tt.ka and rAttack then
            pcall(function()
                local nv = LP.Character
                local goc = nv and nv:FindFirstChild("HumanoidRootPart")
                if not goc then return end
                local gan, kcMin = nil, 35
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        local mt = p.Character:FindFirstChild("HumanoidRootPart")
                        local h = p.Character:FindFirstChildOfClass("Humanoid")
                        if mt and h and h.Health > 0 then
                            local kc = (goc.Position - mt.Position).Magnitude
                            if kc <= kcMin then kcMin = kc; gan = h end
                        end
                    end
                end
                if gan then rAttack:FireServer(gan) end
            end)
        end
    end
end)

